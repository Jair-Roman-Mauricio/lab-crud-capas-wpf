<UserControl x:Class="Presentacion.Vistas.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="0,2,0,8"/><Setter Property="Padding" Value="4"/></Style>
        <Style TargetType="Button"><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="8,5"/></Style>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtBuscar" Width="260" Margin="0" TextChanged="Buscar_Changed"/>
            <ToggleButton x:Name="btnPapelera" Content="Ver eliminados" Margin="12,0,0,0" Padding="10,4" Click="Papelera_Click"/>
            <TextBlock x:Name="lblModo" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#B00020"/>
        </StackPanel>
        <DataGrid x:Name="grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="Grid_SelectionChanged" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding IdProducto}" Width="40"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="100"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70"/>
                <DataGridTextColumn x:Name="colFecha" Header="Eliminado el" Binding="{Binding FechaEliminacion, StringFormat=dd/MM/yyyy HH:mm}" Width="130" Visibility="Collapsed"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="12,0,0,0">
            <TextBlock Text="Nombre"/><TextBox x:Name="txtNombre"/>
            <TextBlock Text="Descripción"/><TextBox x:Name="txtDescripcion"/>
            <TextBlock Text="Categoría"/><ComboBox x:Name="cboCategoria" DisplayMemberPath="Nombre" SelectedValuePath="IdCategoria" Margin="0,2,0,8" Padding="4"/>
            <TextBlock Text="Precio"/><TextBox x:Name="txtPrecio"/>
            <TextBlock Text="Stock"/><TextBox x:Name="txtStock"/>
            <Button x:Name="btnGuardar" Content="Guardar" Click="Guardar_Click"/>
            <Button x:Name="btnNuevo" Content="Nuevo / Limpiar" Click="Nuevo_Click"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Click="Eliminar_Click"/>
            <Button x:Name="btnRestaurar" Content="Restaurar seleccionado" Click="Restaurar_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
